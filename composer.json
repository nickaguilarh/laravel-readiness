{
    "name": "nickaguilarh/laravel-readiness",
    "description": "Readiness probe toolkit for Laravel: per-instance drain mode, bounded database/redis/horizon checks, a budgeted probe runner and a token/IP access guard.",
    "keywords": [
        "laravel",
        "readiness",
        "health",
        "drain",
        "load-balancer",
        "probe",
        "maintenance"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Nick Aguilar H",
            "email": "nickaguilarh@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/nickaguilarh/laravel-readiness/issues",
        "source": "https://github.com/nickaguilarh/laravel-readiness",
        "security": "https://github.com/nickaguilarh/laravel-readiness/security/policy"
    },
    "require": {
        "php": "^8.1",
        "illuminate/console": "^8.83|^9.0|^10.0|^11.0|^12.0",
        "illuminate/contracts": "^8.83|^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^8.83|^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^8.83|^9.0|^10.0|^11.0|^12.0",
        "illuminate/routing": "^8.83|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^8.83|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.47|^7.0|^8.0|^9.0|^10.0",
        "phpbench/phpbench": "^1.2",
        "phpstan/phpstan": "^1.11|^2.0",
        "laravel/pint": "^1.13"
    },
    "suggest": {
        "illuminate/redis": "Required by the redis check.",
        "laravel/horizon": "Enables the horizon check."
    },
    "autoload": {
        "psr-4": {
            "Readiness\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Readiness\\Tests\\": "tests/",
            "Readiness\\Benchmarks\\": "benchmarks/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Readiness\\ReadinessServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --coverage-filter=src",
        "coverage": "phpdbg -qrr vendor/bin/phpunit --coverage-filter=src --coverage-text",
        "bench": "vendor/bin/phpbench run benchmarks --report=aggregate",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "lint": "vendor/bin/pint --test",
        "security": "composer audit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
